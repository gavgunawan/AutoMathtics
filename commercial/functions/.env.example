# Per-project parameters for the SMS ladder function, read by the Firebase CLI at deploy time from
# functions/.env.<PROJECT_ID> (written by scripts/cloudshell/06-sms-ladder.sh; git-ignored). No secrets here:
# the pepper lives in Secret Manager as AM_V3_SMS_PEPPER.
# The function runs as its own service account — roles/datastore.user on the project and secretAccessor on that
# one secret, nothing else — never as the v3 runtime account, which holds firebaseauth.admin and every server secret.
SMS_LADDER_SERVICE_ACCOUNT=automathtics-v3-sms-ladder@YOUR_PROJECT_ID.iam.gserviceaccount.com
