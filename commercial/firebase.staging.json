{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".hosting",
    "ignore": [
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "automathtics-v3",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
