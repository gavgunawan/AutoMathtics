# Copy to .env for LOCAL development only. Never point this build at the legacy project.
APP_MODE=emulator
FIREBASE_PROJECT_ID=demo-am-foundation
APP_ORIGIN=http://127.0.0.1:8787
PORT=8787
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
FIREBASE_WEB_API_KEY=demo-key
FIREBASE_WEB_APP_ID=demo-app
# Generate TWO independent values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_HEX
PIN_PEPPER=REPLACE_WITH_DIFFERENT_RANDOM_HEX
# Stage 3.3: signs the fake payment provider's webhooks (scripts/fake-webhook.mjs). A third independent value.
WEBHOOK_SECRET_FAKE=REPLACE_WITH_A_THIRD_RANDOM_HEX
# fake (zero cost, signed fixtures) or stripe. Outside the emulator the fake provider needs FAKE_PAYMENTS_ACK=no-real-money.
PAYMENT_PROVIDER=fake
# Stage 4.1: Stripe in TEST mode (no fees). Keys from the Stripe dashboard's test view; the whsec_ from `stripe listen`
# or the endpoint page; price ids for the three plans created in the test catalogue.
# STRIPE_SECRET_KEY=sk_test_...
# WEBHOOK_SECRET_STRIPE=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_FAMILY=price_...
# STRIPE_PRICE_BIG=price_...
# Retired peppers, comma-separated, kept only until every PIN has been re-hashed under the current one.
# PIN_PEPPER_PREVIOUS=
# Number of trusted proxies in front of the server (Hosting + Cloud Run = 2); 0 locally. Required (0-5) in staging/production.
TRUSTED_PROXY_HOPS=0
# email-v1: the weekly progress email job (scripts/report.mjs; the server itself sends nothing). fake, the default, keeps each
# email in Firestore's outbox for 14 days instead of sending it; resend sends through the owner's Resend account, whose key
# lives in Secret Manager as am-v3-email-key. The job also needs SESSION_SECRET (it signs the buttons) and APP_ORIGIN.
# EMAIL_PROVIDER=fake
# EMAIL_API_KEY=re_...
# EMAIL_FROM=AutoMathtics <onboarding@resend.dev>
