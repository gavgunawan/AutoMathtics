{
  "name": "automathtics-secure-foundation",
  "version": "3.59.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file=.env server/main.mjs",
    "start:cloud": "node server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:emulator": "firebase emulators:exec --project demo-am-foundation --only auth,firestore \"node --test tests/emulator.integration.mjs\"",
    "emulators": "firebase emulators:start --project demo-am-foundation --only auth,firestore",
    "grant": "node --env-file=.env scripts/grant.mjs",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "grant:cloud": "node scripts/grant.mjs",
    "migrate": "node --env-file=.env scripts/migrate-v2.mjs",
    "migrate:cloud": "node scripts/migrate-v2.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.3.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.29.0"
  },
  "description": "AutoMathtics v3.0 private-pilot account and security foundation"
}
